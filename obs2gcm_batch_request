#!/bin/bash

#SBATCH -n 1
#SBATCH --partition=cpu-long
#SBATCH -t 1-00:00:00
#SBATCH --mem=200G
#SBATCH --array=0-3

vars=(hus ta ua va)
var=${vars[$SLURM_ARRAY_TASK_ID]}
echo "Processing variable: ${var}"

source /opt/conda/etc/profile.d/conda.sh
conda activate $DATADIR/conda_envs/sdmbcv2
ulimit -l unlimited
srun python ./src/interp_obs2gcm.py --yp src/config_interp_3d.yaml --var ${var} --ncpus 1 --mem 200
conda deactivate
